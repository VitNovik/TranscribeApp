{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TranscribeApp",
  "version": "1.0.0",
  "identifier": "com.transcribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TranscribeApp",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Audio/Video transcription with speaker diarization",
    "longDescription": "A native macOS application for local audio and video transcription with automatic speaker diarization. All processing is done locally without cloud services.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "scope": ["$HOME/.transcribe/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**"]
    },
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "ffmpeg",
          "cmd": "ffmpeg",
          "args": true
        },
        {
          "name": "ffprobe",
          "cmd": "ffprobe",
          "args": true
        }
      ]
    },
    "clipboard-manager": {}
  }
}
